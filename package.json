    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  }
}
